# Resend API key for automatic website enquiry delivery.
RESEND_API_KEY=re_your_resend_api_key
# Must be a verified sender in the Resend account, for example:
MAIL_FROM=Gajanan Industries <enquiries@gajanan.net>
# Notification recipient for every website enquiry.
ENQUIRY_EMAIL=ssaivaraprasad51@gmail.com
# The equivalent Supabase Edge Function secret is named ENQUIRY_RECIPIENT.
ENQUIRY_RECIPIENT=ssaivaraprasad51@gmail.com
# Keep this private. It is validated only by the server and is never stored in website code.
ADMIN_ACCESS_CODE=replace-with-a-long-random-secret-code
